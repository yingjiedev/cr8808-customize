#!/bin/sh /etc/rc.common
# Start the proxy only after WAN is usable; leave local DHCP/DNS available offline.
START=99
STOP=9

start() {
	[ "$(uci -q get homeproxy.config.cr8808_autostart)" = '1' ] || return 0
	[ "$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.up')" = 'true' ] || return 0
	[ "$(uci -q get homeproxy.config.main_node)" != 'nil' ] || return 0
	/etc/init.d/homeproxy running 2>/dev/null && return 0
	/etc/init.d/homeproxy start
}

stop() {
	/etc/init.d/homeproxy stop
}
